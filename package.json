    "cli",
    "snapshot",
    "ai",
    "markdown",
    "sanitizer",
    "prompt"
  ],
  "author": "lakshyakurup",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
