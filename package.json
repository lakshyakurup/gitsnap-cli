{
  "name": "gitsnap-cli",
  "version": "1.0.0",
  "description": "Lightweight CLI that snapshots sanitized Git context into AI-ready Markdown",
  "main": "server.js",
  "bin": {
    "gitsnap": "./index.js"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node sanitizer.test.js",
    "snap": "node index.js --diff"
  },
  "keywords": [
